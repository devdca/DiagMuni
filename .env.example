# ENVIRONMENT: "development" habilita scripts de datos ficticios (app/seed.py).
# En producción DEBE ser "production" — el seed aborta si detecta ese valor.
ENVIRONMENT=development

# Base de datos (docs/backend-schema.md)
# DATABASE_URL: rol de aplicación SIN privilegios de superusuario (backend/db-init/01-app-role.sql)
# — es el que de verdad queda sujeto a RLS. Un superusuario (como el de MIGRATIONS_DATABASE_URL)
# ignora RLS siempre, sin importar ENABLE/FORCE — por eso las migraciones usan un rol separado.
DATABASE_URL=postgresql+psycopg://diagmuni_app:diagmuni_app_password@db:5432/diagmuni
MIGRATIONS_DATABASE_URL=postgresql+psycopg://diagmuni:diagmuni@db:5432/diagmuni

# Autenticación JWT (docs/backend-schema.md)
# JWT_SECRET: genera uno real por despliegue, nunca reutilices este placeholder --
# ej. `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Con
# ENVIRONMENT=production, dejarlo vacío o igual a este valor de ejemplo aborta el
# arranque a propósito (backend/app/core/config.py) porque compromete
# autenticación y aislamiento entre gobiernos (RLS) por completo.
JWT_SECRET=cambia-esto-por-un-secreto-real
JWT_EXPIRE_HOURS=8

# Capa de IA (docs/TRD.md) — opcional en fases A-D (motor determinista no depende de esto).
# Su ausencia degrada a plantillas deterministas, nunca rompe el arranque (docs/TRD.md).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_API_BASE: URL del servidor Ollama. Si activás el perfil opcional de
# Docker Compose (`docker compose --profile ia-local up -d`, ver
# docs/runbook-despliegue.md), el servicio se llama `ollama` en la red interna
# de Compose -- usá http://ollama:11434. Si en cambio corrés Ollama fuera de
# Docker (otro proceso, otro host), usá esa URL en su lugar, ej. http://localhost:11434.
# Vacía + sin LLM_PROVIDER: no rompe el arranque, degrada a plantilla determinista.
OLLAMA_API_BASE=

# LLM_PROVIDER: valores válidos "anthropic" / "deepseek" / "local". Decide qué
# proveedor usa la Capa IA (backend/app/ia/config.py, obtener_proveedor_llm()).
# Vacía o ausente -> default "local" si OLLAMA_API_BASE está poblada; si tampoco
# hay OLLAMA_API_BASE, cae a plantilla determinista (nunca elige automáticamente
# "anthropic"/"deepseek" solo porque su API key esté presente). Fijar
# LLM_PROVIDER=anthropic o =deepseek es la única forma de usar una API de pago en
# producción — decisión explícita del operador de cada despliegue: la plataforma
# nunca debe gastar en una API de pago sin que se lo pidan a propósito.
LLM_PROVIDER=

# Postgres (para el servicio db de docker-compose.yml)
POSTGRES_USER=diagmuni
POSTGRES_PASSWORD=diagmuni
POSTGRES_DB=diagmuni

# HTTPS/TLS (opcional, docs/runbook-despliegue.md, "HTTPS/TLS") -- solo se usan
# si se activa docker-compose.tls.yml (servicio caddy). Vacías, ese archivo no
# arranca de forma útil -- Caddy no puede pedir un certificado sin un dominio.
# TLS_DOMAIN: el dominio real que ya apunta (registro A/AAAA) a este servidor.
# TLS_EMAIL: correo de contacto que Let's Encrypt usa para avisos de expiración.
TLS_DOMAIN=
TLS_EMAIL=

# COMPOSE_FILE (opcional): Compose la lee sola, sin necesitar `-f` en cada
# comando. Fijarla en esta forma activa docker-compose.tls.yml de manera
# permanente para todo comando futuro (up, down, build) -- ver
# docs/runbook-despliegue.md, "HTTPS/TLS", antes de descomentarla.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
