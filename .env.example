# ENVIRONMENT: "development" habilita scripts de datos ficticios (app/seed.py).
# En producción DEBE ser "production" — el seed aborta si detecta ese valor.
ENVIRONMENT=development

# Base de datos (docs/backend-schema.md)
# DATABASE_URL: rol de aplicación SIN privilegios de superusuario (backend/db-init/01-app-role.sql)
# — es el que de verdad queda sujeto a RLS. Un superusuario (como el de MIGRATIONS_DATABASE_URL)
# ignora RLS siempre, sin importar ENABLE/FORCE — por eso las migraciones usan un rol separado.
DATABASE_URL=postgresql+psycopg://diagmuni_app:diagmuni_app_password@db:5432/diagmuni
MIGRATIONS_DATABASE_URL=postgresql+psycopg://diagmuni:diagmuni@db:5432/diagmuni

# Autenticación JWT (docs/backend-schema.md)
# JWT_SECRET: genera uno real por despliegue, nunca reutilices este placeholder --
# ej. `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Con
# ENVIRONMENT=production, dejarlo vacío o igual a este valor de ejemplo aborta el
# arranque a propósito (backend/app/core/config.py) porque compromete
# autenticación y aislamiento entre gobiernos (RLS) por completo. Placeholder de
# 39 caracteres a propósito (>= 32, el mínimo de RFC 7518 §3.2 para HMAC-SHA256)
# -- así development/test nunca disparan `InsecureKeyLengthWarning` de pyjwt por
# copiar este ejemplo tal cual (auditoría de pase a producción, 2026-09-14).
JWT_SECRET=cambia-esto-por-un-secreto-real-y-largo
JWT_EXPIRE_HOURS=8

# TENANT_SECRET_KEY: cifra las credenciales de IA que cada gobierno trae consigo
# (BYOK, app/core/cifrado.py) antes de guardarlas -- nunca reutilices este
# placeholder ni la JWT_SECRET de arriba (propósitos distintos, radios de daño
# distintos si se filtran). Debe ser una clave Fernet válida (32 bytes en base64
# urlsafe) -- genera una real por despliegue, ej.:
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Con ENVIRONMENT=production, dejarla vacía o igual a este placeholder aborta el
# arranque a propósito. Rotarla invalida todas las credenciales ya guardadas por
# los gobiernos -- cada uno tendría que volver a pegar su key.
TENANT_SECRET_KEY=ZGV2LXNlY3JldC1jYW1iaWFyLWVuLXByb2R1Y2Npb24=

# Capa de IA (docs/TRD.md) — opcional en fases A-D (motor determinista no depende de esto).
# Su ausencia degrada a plantillas deterministas, nunca rompe el arranque (docs/TRD.md).
# DEEPSEEK_API_KEY / ANTHROPIC_API_KEY de acá abajo son SOLO el fallback del
# operador de este despliegue (útil en dev/pruebas) -- cada gobierno puede traer
# y guardar su propia credencial desde /admin/salud-ia (BYOK, ver
# app/core/cifrado.py y app/adaptadores/llm/config.py::OverrideLlmTenant), que
# siempre gana sobre estas variables. En un despliegue público real, dejar estas
# dos vacías es la opción esperada: cada gobierno paga y controla la suya.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_API_BASE: URL del servidor Ollama. Si activás el perfil opcional de
# Docker Compose (`docker compose --profile ia-local up -d`, ver
# docs/runbook-despliegue.md), el servicio se llama `ollama` en la red interna
# de Compose -- usá http://ollama:11434. Si en cambio corrés Ollama fuera de
# Docker (otro proceso, otro host), usá esa URL en su lugar, ej. http://localhost:11434.
# Vacía + sin LLM_PROVIDER: no rompe el arranque, degrada a plantilla determinista.
OLLAMA_API_BASE=

# LLM_PROVIDER: valores válidos "anthropic" / "deepseek" / "local". Decide qué
# proveedor usa la Capa IA (backend/app/ia/config.py, obtener_proveedor_llm()).
# Vacía o ausente -> default "local" si OLLAMA_API_BASE está poblada; si tampoco
# hay OLLAMA_API_BASE, cae a plantilla determinista (nunca elige automáticamente
# "anthropic"/"deepseek" solo porque su API key esté presente). Fijar
# LLM_PROVIDER=anthropic o =deepseek es la única forma de usar una API de pago en
# producción — decisión explícita del operador de cada despliegue: la plataforma
# nunca debe gastar en una API de pago sin que se lo pidan a propósito.
LLM_PROVIDER=

# INEGI_API_TOKEN: token gratuito de la API de Indicadores de INEGI
# (inegi.org.mx/servicios/api_indicadores.html) -- habilita el botón
# "Sincronizar con INEGI" del Perfil del gobierno (prellena poblacion_total).
# Vacía: la sincronización queda deshabilitada sin romper nada más (fail-closed,
# ver backend/app/adaptadores/inegi/cliente_inegi.py). Registro de token y datos
# de cada gobierno (clave_geoestadistica) son independientes de esta variable.
INEGI_API_TOKEN=

# LOGO_MAX_BYTES: tope de tamaño para el logo que cada gobierno sube en su Perfil
# (PUT /api/gobierno/logo, backend/app/aplicacion/gestion_logo.py) -- png/jpg/svg.
# Default 3 MB, generoso para un logo institucional sin dejar que un tenant llene
# el volumen `diagmuni_logos_data`. Si lo subís, actualizá también
# `client_max_body_size` de la ruta `/api/gobierno/logo` en nginx/nginx.conf (con
# margen: el body multipart trae boundary/headers propios además del archivo) --
# nginx rechaza antes de que el backend siquiera vea el request si no coinciden.
LOGO_MAX_BYTES=3145728

# VITE_SENTRY_DSN (opcional): captura de errores de JS en producción
# (frontend/src/lib/sentry.ts). Vacía/ausente: no se inicializa Sentry, cero
# overhead, mismo comportamiento de hoy. Es una variable de BUILD del
# frontend, no del backend -- nunca llega al contenedor `backend`, ni la lee
# ningún código Python; docker-compose.yml la pasa como build arg al servicio
# `nginx` (nginx/Dockerfile compila el frontend con Vite ahí), así que un
# cambio de valor requiere reconstruir esa imagen (`docker compose build
# nginx`), no solo reiniciar el contenedor. Antes de activar un DSN real acá,
# ver el comentario sobre `connect-src` en nginx/nginx.conf -- si no se agrega
# esa excepción a la CSP, el navegador bloquea en silencio el reporte de
# errores hacia Sentry.
VITE_SENTRY_DSN=

# SENTRY_DSN (opcional): captura de errores 5xx/excepciones no manejadas del
# backend (backend/app/core/observabilidad.py, backend/app/main.py) -- DSN
# distinto de VITE_SENTRY_DSN de arriba (proyectos separados backend/frontend,
# aunque nada impide usar el mismo si así se prefiere). Vacía/ausente:
# `sentry_sdk.init` nunca se llama, cero overhead, cero llamadas de red. Nunca
# manda cuerpo de request ni headers de autenticación (ver ese módulo) -- solo
# 401/403/404 quedan explícitamente fuera de lo que cuenta como "falla".
#
# Destino recomendado: GlitchTip autohospedado, no sentry.io -- mismo
# protocolo, pero open source (MIT), coherente con "sin componentes
# privativos" del README raíz, y los datos de error se quedan en
# infraestructura propia. Ver docs/runbook-despliegue.md, "Observabilidad de
# errores (GlitchTip)", para levantarlo (`docker compose --profile
# observabilidad up -d`) y generar este valor. sentry.io sigue siendo una
# alternativa válida para quien prefiera no autohospedar -- es la misma
# variable, solo cambia a qué DSN apunta.
SENTRY_DSN=

# Variables del perfil opcional de GlitchTip (docker-compose.yml, profile
# "observabilidad") -- solo aplican si ese perfil está activo. Vacías, usan el
# placeholder de docker-compose.yml (nunca válido para un uso real, mismo
# criterio que JWT_SECRET/TENANT_SECRET_KEY de arriba).
# GLITCHTIP_SECRET_KEY: generar uno real, mismo comando que JWT_SECRET (Paso 2).
GLITCHTIP_SECRET_KEY=
# GLITCHTIP_DOMAIN: URL pública si se expone más allá de localhost:8091.
GLITCHTIP_DOMAIN=
# GLITCHTIP_DEFAULT_FROM_EMAIL: remitente de los correos que manda GlitchTip
# (invitaciones, alertas) -- sin EMAIL_URL real, esos correos solo se imprimen
# en `docker compose logs glitchtip`, no salen de verdad.
GLITCHTIP_DEFAULT_FROM_EMAIL=

# ALERTA_WEBHOOK_URL (opcional): a dónde manda scripts/vigilar_salud.py su
# aviso tras varios chequeos de /health seguidos fallando (docs/runbook-
# despliegue.md, "Vigilancia de /health") -- genérico, cualquier endpoint que
# reciba un POST con {"text": "..."} sirve (Slack Incoming Webhook, Discord
# con /slack al final de la URL, etc.). Vacía/ausente: las caídas se siguen
# registrando en el log del script, solo sin mandar el aviso -- nunca falla
# por falta de configuración. No la lee el backend (`app/`), solo ese script.
ALERTA_WEBHOOK_URL=

# Postgres (para el servicio db de docker-compose.yml)
POSTGRES_USER=diagmuni
POSTGRES_PASSWORD=diagmuni
POSTGRES_DB=diagmuni

# HTTPS/TLS (opcional, docs/runbook-despliegue.md, "HTTPS/TLS") -- solo se usan
# si se activa docker-compose.tls.yml (servicio caddy). Vacías, ese archivo no
# arranca de forma útil -- Caddy no puede pedir un certificado sin un dominio.
# TLS_DOMAIN: el dominio real que ya apunta (registro A/AAAA) a este servidor.
# TLS_EMAIL: correo de contacto que Let's Encrypt usa para avisos de expiración.
TLS_DOMAIN=
TLS_EMAIL=

# COMPOSE_FILE (opcional): Compose la lee sola, sin necesitar `-f` en cada
# comando. Fijarla en esta forma activa docker-compose.tls.yml de manera
# permanente para todo comando futuro (up, down, build) -- ver
# docs/runbook-despliegue.md, "HTTPS/TLS", antes de descomentarla.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
