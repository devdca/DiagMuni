# Material interno — nunca versionado (proceso de desarrollo, no producto)
/Contexto/
/sesiones/
/Local/
/.claude/
/CLAUDE.md
/docs/plan-trabajo.md
/docs/sistema-multiagente.md
/entregables/plan.md

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Playwright (E2E del frontend)
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Artefactos del MCP de Playwright (exploración interactiva, no del proyecto)
/.playwright-mcp/

# Entorno y secretos
.env
.env.*
!.env.example

# Editores
.vscode/
.idea/

# Override local de docker compose (ej. exponer el puerto de Postgres al host
# para correr pytest local contra Postgres real) -- conveniencia de cada
# máquina de desarrollo, nunca parte de la configuración de referencia.
docker-compose.override.yml

# Resultados de pruebas de seguridad (Strix) — reportes de vulnerabilidades reales,
# nunca al repo público hasta que las críticas/altas estén corregidas y confirmadas.
/strix_runs/
strix_run.log

# Mockups de diseño (artboards HTML sueltos, fuera del build de frontend/) --
# material de trabajo visual, no producto: no se sirven, no se testean y no
# tienen licencia de terceros verificada.
/scratch-canvas/

# Salidas crudas de escáneres de seguridad, mismo criterio que /strix_runs/
# arriba: se leen, se corrigen y se citan en docs/, nunca se versiona el volcado.
reporte-bandit.txt
